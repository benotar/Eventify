@page
@model Index

@{
    ViewData["Title"] = Captions.LogoutTitle;
}

<div class="w-full max-w-sm">
    <div class="text-center mb-8">
        <div class="brand-icon mb-5">
            <svg
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
            </svg>
        </div>

        <h1 class="brand-title">
            @Captions.ApplicationTitle
        </h1>

    </div>
    <div class="card text-center">
        <div class="status-icon status-icon-danger">
            <svg
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
        </div>

        <h2 class="card-title">
            @Captions.LogoutHeading
        </h2>
        <p
            class="card-text"
            style="margin-bottom: 2rem;">

            @Captions.LogoutConfirm
        </p>

        <form method="post">
            <input
                type="hidden"
                asp-for="LogoutId"/>
            <button
                type="submit"
                class="btn btn-danger">

                @Captions.LogoutButton
            </button>
        </form>
        <a
            href="/"
            class="link-muted">
            @Captions.Cancel
        </a>
    </div>
</div>