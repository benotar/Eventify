@page
@model Index

@{
    ViewData["Title"] = Captions.LoginTitle;
}

<div class="w-full max-w-md">

    <div class="text-center mb-8">
        <div class="brand-icon mb-5">
            <svg
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
            </svg>
        </div>
        <h1 class="brand-title">
            @Captions.ApplicationTitle
        </h1>
        <p class="brand-subtitle">
            @Captions.LoginSubtitle
        </p>
    </div>

    <div class="card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-box">
                <div asp-validation-summary="ModelOnly"></div>
            </div>
        }
        <form method="post" class="space-y-5">
            <input
                type="hidden"
                asp-for="ReturnUrl"/>
            <div>
                <label
                    asp-for="Input.Email"
                    class="label-caps">
                </label>
                <input
                    asp-for="Input.Email"
                    class="glass-input"
                    placeholder="email@example.com"/>
                <span
                    asp-validation-for="Input.Email"
                    class="field-error">
                </span>
            </div>
            <div>
                <label
                    asp-for="Input.Password"
                    class="label-caps">
                </label>
                <input
                    asp-for="Input.Password"
                    type="password"
                    class="glass-input"
                    placeholder="••••••••••"/>
                <span
                    asp-validation-for="Input.Password"
                    class="field-error">
                </span>
            </div>
            <button
                type="submit"
                class="btn btn-primary mt-2">
                @Captions.LoginButton
            </button>

        </form>

    </div>

</div>