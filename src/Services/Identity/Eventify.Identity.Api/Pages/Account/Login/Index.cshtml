@page
@model Index

@{
    ViewData["Title"] = "Sign In";
}

<div class="w-full max-w-md px-4">

    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-white">Eventify</h1>
        <p class="text-slate-400 mt-2">Sign in to your account</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8">

        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="ModelOnly"
                 class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
            </div>
        }

        <form method="post" class="space-y-5">
            <input type="hidden" asp-for="ReturnUrl"/>

            <div>
                <label asp-for="Input.Email"
                       class="block text-sm font-medium text-slate-700 mb-1">
                </label>
                <input asp-for="Input.Email"
                       class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm
                                focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                       placeholder="your.email@example.com"/>
                <span asp-validation-for="Input.Email"
                      class="text-red-600 text-xs mt-1 block">
                  </span>
            </div>

            <div>
                <label asp-for="Input.Password"
                       class="block text-sm font-medium text-slate-700 mb-1">
                </label>
                <input asp-for="Input.Password" type="password"
                       class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm
                                focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent"
                       placeholder="••••••••"/>
                <span asp-validation-for="Input.Password"
                      class="text-red-600 text-xs mt-1 block">
                  </span>
            </div>

            <button type="submit"
                    class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white
                             font-semibold rounded-lg text-sm transition-colors">
                Sign in
            </button>
        </form>
    </div>
</div>