@page
@using System.Globalization
@model Error

@{
    Layout = null;
}

<!doctype html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        @Captions.ErrorTitle — Eventify
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
        rel="stylesheet"
        href="~/css/auth.css"
        asp-append-version="true"/>
</head>
<body>
<partial name="_Background"/>

<div class="page-shell">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <div class="brand-icon mb-5">
                <svg
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8">
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
                </svg>
            </div>
            <h1 class="brand-title">
                @Captions.ApplicationTitle
            </h1>
        </div>
        <div class="card text-center">
            <p class="status-code status-code-amber">
                500
            </p>
            <div class="status-icon status-icon-amber">
                <svg
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="1.8">
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
            <h2 class="card-title">
                @Captions.ErrorTitle
            </h2>
            <p
                class="card-text"
                style="margin-bottom: 2rem;">
                @Captions.ErrorMessage
            </p>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p
                    class="card-text"
                    style="margin-bottom: 1.5rem; opacity: .6; font-family: monospace;">
                    @Model.ErrorMessage
                </p>
            }
            <a
                href="/"
                class="btn btn-primary">
                @Captions.GoHome
            </a>
        </div>
    </div>
</div>
</body>
</html>