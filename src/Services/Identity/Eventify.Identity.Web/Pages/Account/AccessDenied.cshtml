@page
@model Eventify.Identity.Web.Pages.Account.AccessDenied

@{
    ViewData["Title"] = Captions.AccessDeniedTitle;
}

<div class="w-full max-w-sm">
    <div class="text-center mb-8">
        <div class="brand-icon mb-5">
            <svg
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 00-2 2v3a2 2 0 110 4v3a2 2 0 002 2h14a2 2 0 002-2v-3a2 2 0 110-4V7a2 2 0 00-2-2H5z"/>
            </svg>
        </div>
        <h1 class="brand-title">
            @Captions.ApplicationTitle
        </h1>
    </div>
    <div class="card text-center">
        <p class="status-code status-code-rose">
            403
        </p>
        <div class="status-icon status-icon-danger">
            <svg
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="1.8">
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
        </div>
        <h2 class="card-title">
            @Captions.AccessDeniedTitle
        </h2>
        <p
            class="card-text"
            style="margin-bottom: 2rem;">
            @Captions.AccessDeniedMessage
        </p>
        <a
            href="/"
            class="btn btn-primary">
            @Captions.GoHome
        </a>
    </div>
</div>